# Copy to backend/.env for running the backend outside Docker.
# docker-compose.yml already sets sensible dev values for these.

FLASK_APP=wsgi.py
FLASK_CONFIG=development          # development | testing | production

# Use long random values (>= 32 bytes), e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
PASSWORD_HASH_METHOD=scrypt

DATABASE_URL=postgresql+psycopg://accesshub:accesshub@localhost:5432/accesshub
TEST_DATABASE_URL=postgresql+psycopg://accesshub:accesshub@localhost:5432/accesshub_test

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=AccessHub <no-reply@accesshub.dev>

FRONTEND_URL=http://localhost:5173            # used for deep links in emails

# Background jobs (escalation every N minutes, expiry + reminders daily at the given UTC hour).
# Enable on exactly one process/container in production.
RUN_SCHEDULER=0
ESCALATION_INTERVAL_MINUTES=15
DAILY_JOB_HOUR_UTC=2
EXPIRY_REMINDER_DAYS=7
