# Copy to backend/.env for running the backend outside Docker.
# docker-compose.yml already sets sensible dev values for these.

FLASK_APP=wsgi.py
FLASK_CONFIG=development          # development | testing | production

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DATABASE_URL=postgresql+psycopg://accesshub:accesshub@localhost:5432/accesshub
TEST_DATABASE_URL=postgresql+psycopg://accesshub:accesshub@localhost:5432/accesshub_test

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=AccessHub <no-reply@accesshub.dev>

FRONTEND_URL=http://localhost:5173
RUN_SCHEDULER=0
