# Copy to .env next to docker-compose.prod.yml and fill in real values. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Images (CI pushes ghcr.io/<owner>/accesshub-{backend,frontend}:<git sha> and :latest)
REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest
HTTP_PORT=80

# HTTPS (only with docker-compose.tls.yml): your public domain, whose DNS points at this server.
# Caddy gets and renews a Let's Encrypt certificate for it automatically.
SITE_ADDRESS=accesshub.example.com
HTTPS_PORT=443

# Database
POSTGRES_USER=accesshub
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=accesshub

# Application secrets (>= 32 characters each)
SECRET_KEY=change-me-long-random
JWT_SECRET_KEY=change-me-long-random-too

# Public URL of the site (used for links in emails)
FRONTEND_URL=https://accesshub.example.com

# Outgoing mail (SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=AccessHub <no-reply@example.com>
